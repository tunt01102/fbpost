# Sao chép file này thành .env rồi điền. KHÔNG commit .env lên git.
# Token/secret là BÍ MẬT — lưu cục bộ, không chia sẻ.

# Nhà cung cấp AI: claude_cli | gemini_cli | codex_cli | local | claude | openai | gemini
LLM_PROVIDER=claude_cli

# Chỉ cần khi dùng provider API trả phí (không bắt buộc — mặc định dùng CLI subscription)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Model local (tuỳ chọn) — vd Ollama: http://localhost:11434/v1
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=

# Facebook Fanpage (Graph API) — khuyến nghị
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# Thông báo (tuỳ chọn): webhook Slack/Discord
NOTIFY_WEBHOOK_URL=
